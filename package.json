{
  "name": "@memoarchitect/ontology",
  "version": "0.8.0",
  "packageManager": "pnpm@9.15.0",
  "description": "MEMO \u2014 Medical Engineering Modelling Ontology. Pure SysML v2 medical-device ontology with native constraints, portable to any conformant SysML v2 tool (SysIDE, SysON, sysand).",
  "scripts": {
    "build": "bash scripts/build-kpar.sh",
    "check": "bash scripts/build-kpar.sh && npm run lint",
    "lint": "node ../memo-tools/packages/tools/lib/bin/memo.js dhf lint",
    "test": "node --test test/package.test.mjs",
    "docs:api": "node scripts/generate-sysml-api.mjs",
    "docs:diagrams": "node scripts/generate-reference-diagrams.mjs",
    "docs:serve": "node scripts/generate-reference-diagrams.mjs && node scripts/generate-sysml-api.mjs && node scripts/check-reference-coverage.mjs && python3 -m mkdocs serve",
    "docs:build": "node scripts/generate-reference-diagrams.mjs && node scripts/generate-sysml-api.mjs && node scripts/check-reference-coverage.mjs && python3 -m mkdocs build --strict",
    "docs:check-reference": "node scripts/check-reference-coverage.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "keywords": [
    "sysml-v2",
    "kerml",
    "medical-device",
    "iso-14971",
    "iec-62304",
    "ontology",
    "mbse"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memoarchitect/memo.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./manifest": "./memo.manifest.yaml",
    "./src/*": "./src/*",
    "./profile/*": "./profile/*",
    "./methodologies/*": "./methodologies/*",
    "./templates/*": "./templates/*",
    "./examples/*": "./examples/*"
  },
  "files": [
    "README.md",
    "LICENSE",
    "memo.manifest.yaml",
    "ontology/memo.package.yaml",
    "profile/memo.package.yaml",
    "methodologies/default/memo.package.yaml",
    "methodologies/gpca/memo.package.yaml",
    "src/assurance/",
    "src/architecture/",
    "src/artifacts/",
    "src/core/",
    "src/methodology/archetypes/",
    "src/methodology/core/",
    "src/methodology/gates/",
    "src/methodology/patterns/",
    "src/methodology/profiles/",
    "src/methodology/rules/",
    "src/methodology/viewpoints/",
    "src/methodology/workflow/",
    "src/methodology/LICENSES/",
    "src/rules/",
    "src/viewpoints/",
    "src/memo_namespaces.sysml",
    "templates/",
    "examples/",
    "extensions/"
  ]
}
