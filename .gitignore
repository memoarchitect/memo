# Dependencies
node_modules/
.pnpm-store/

# Local npm config (e.g. left behind by npm publish)
.npmrc

# SysAnd local cache + generated build metadata
# .meta.json is regenerated deterministically by scripts/build-kpar.mjs
*.meta.json
output/
.sysand/
sysand_env/

# KerML Project Archives (build artifacts)
*.kpar

# Package and compiler output
build/
dist/
*.whl
*.tar.gz
*.tgz
*.tsbuildinfo
*.map
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.wasm

# Python bytecode and tool caches
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Test output. Use root-anchored /coverage/ because src/rules/coverage/ is
# ontology source and must remain tracked.
/.coverage
/.coverage.*
/coverage/
/htmlcov/

# Turborepo per-package cache + build logs
.turbo/

# OS
.DS_Store

# Python (pdm / mkdocs) — the docs site toolchain, identical in memo,
# memo-tools and memo-architect. pdm.lock and .python-version ARE committed;
# .pdm-python is not, because it holds an absolute path to one machine.
.venv/
venv/
__pypackages__/
__pycache__/
*.egg-info/
.pdm-python

# Generated documentation site
site/
public/
_site/

# A compiler's export of the library set, written at release by `memo ship-library`
stage1/
